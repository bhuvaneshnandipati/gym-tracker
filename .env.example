# Display name used in the UI.
VITE_APP_NAME="Gym Tracker"

# Supabase project credentials (added/used from Milestone 2 onward).
# Find these in your Supabase dashboard: Project Settings -> API.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
